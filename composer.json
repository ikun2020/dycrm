{
    "name": "dycrm/app",
    "type": "project",
    "description": "Douyin creator CRM built with Laravel and Filament.",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "bezhansalleh/filament-shield": "^4.0",
        "filament/filament": "~5.0",
        "kholil/nitik": "^1.1",
        "laravel/framework": "^12.61",
        "laravel/tinker": "^2.9",
        "predis/predis": "^2.2",
        "waad/filament-import-wizard": "^1.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.18",
        "nunomaduro/collision": "^8.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "check:encoding": [
            "@php tools/check-mojibake.php"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.3.0"
        },
        "audit": {
            "block-insecure": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
